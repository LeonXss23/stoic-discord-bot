# ==========================================
# Stoic & Grindset Discord Bot Configuration
# ==========================================

# [REQUIRED] Discord Webhook URL for your target channel
# Create this in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# [SCHEDULING] Daily posting time in 24-hour HH:MM format
POST_TIME=10:00

# [TIMEZONE] IANA Timezone string (automatically handles Daylight Saving Time transitions)
TIMEZONE=Europe/Ljubljana

# [PINTEREST SEARCH QUERIES] Comma-separated search terms for gritty stoic & grindset quotes
SEARCH_QUERIES=stoic quotes black and white,grind mindset signs,raw masculine wisdom aesthetic,raw street sign stoic quotes,discipline grindset black white

# [FALLBACK RSS / BOARD FEEDS] Comma-separated list of Pinterest public board RSS feeds or board URLs (used as fallback)
FALLBACK_PINTEREST_FEEDS=https://www.pinterest.com/topics/stoicism/,https://www.pinterest.com/topics/motivational-quotes/

# [STATE MANAGEMENT] Path to SQLite database for deduplication
DATABASE_PATH=history.db

# [LOGGING] Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
